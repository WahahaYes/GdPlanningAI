# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Ignore most files when exporting.
/**                        export-ignore

# Include this addon's folder when downloading from the Asset Library.
/addons                   !export-ignore
/addons/GdPlanningAI      !export-ignore
/addons/GdPlanningAI/**   !export-ignore

# Users need the built binaries in bin/, not the Rust source.
/addons/GdPlanningAI/rust     export-ignore
/addons/GdPlanningAI/rust/**  export-ignore

# Also include script templates.
/script_templates         !export-ignore
/script_templates/**      !export-ignore

# Keep third-party example assets out of GitHub language stats.
examples/**/vendored/** linguist-vendored

# Keep lockfiles and Godot-generated files out of GitHub language stats.
uv.lock linguist-generated
addons/GdPlanningAI/rust/Cargo.lock linguist-generated
*.uid linguist-generated
*.import linguist-generated
