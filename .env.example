# OBS WebSocket Configuration
#
# Setup:
#   1. In OBS: Tools → WebSocket Server Settings → Enable server
#   2. Set password in OBS (matches OBS_PASSWORD below)
#   3. Create a scene with screen capture in OBS (pipewire-screen-capture-source used)
#
# Usage:
#   cp .env.example .env
#   # Edit .env to set your OBS_PASSWORD
#   make record-obs SCENE=examples/hunger_basic_2d.tscn DURATION=10

OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your_password_here
