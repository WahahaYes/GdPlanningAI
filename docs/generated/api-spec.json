        { "name": "simulate_effect", "params": [{ "name": "_agent_blackboard", "type": "GdPAIBlackboard" }, { "name": "_world_state", "type": "GdPAIBlackboard" }], "return": "void", "override_point": true },
        { "name": "get_effect_spec", "params": [], "return": "Array", "override_point": true },
        { "name": "pre_perform_action", "params": [{ "name": "_agent", "type": "GdPAIAgent" }], "return": "Status", "override_point": true },
        { "name": "perform_action", "params": [{ "name": "_agent", "type": "GdPAIAgent" }, { "name": "_delta", "type": "float" }], "return": "Status", "override_point": true },
        { "name": "post_perform_action", "params": [{ "name": "_agent", "type": "GdPAIAgent" }], "return": "Status", "override_point": true },
        { "name": "clone_for_plan", "params": [], "return": "Action", "override_point": true },
        { "name": "get_title", "params": [], "return": "String", "override_point": true },
        { "name": "get_description", "params": [], "return": "String", "override_point": true },
        { "name": "set_state", "params": [{ "name": "agent", "type": "GdPAIAgent" }, { "name": "key", "type": "String" }, { "name": "value", "type": "String", "bridge": "Variant as String", "example": "variant:int:3" }], "return": "void", "override_point": false },
        { "name": "get_state", "params": [{ "name": "agent", "type": "GdPAIAgent" }, { "name": "key", "type": "String" }], "return": "String", "override_point": false },
        { "name": "erase_state", "params": [{ "name": "agent", "type": "GdPAIAgent" }, { "name": "key", "type": "String" }], "return": "void", "override_point": false },
        { "name": "has_state", "params": [{ "name": "agent", "type": "GdPAIAgent" }, { "name": "key", "type": "String" }], "return": "bool", "override_point": false }
      ],
      "notes": "<<extension point>>. Declarative hooks (get_*) describe the action to the planner; planning hooks (get_action_cost/simulate_effect) run on simulated blackboards; execution hooks (*_perform_action) run on the main thread. get_state/set_state Variant payloads are String-typed bridge shapes."
