{
  "spec_version": "1.0",
  "project": "GdPlanningAI",
  "note": "Read-only map merged from the orchestrator interface dump. Callable/Variant/Dictionary values crossing the Rust bridge are serialized, so they are documented here as String-typed with examples. See per-class notes.",
  "bridge_conventions": {
    "Callable": "String-typed bridge shape. Example: \"callable:MyUpdaters:update_hunger\"",
    "Variant_property_value": "String-typed bridge shape. Example: \"variant:int:3\" or \"variant:Vector2(1, 2)\"",
    "Dictionary_bridge_dict": "String-typed bridge shape. Example: \"{\\\"kind\\\": \\\"fact\\\", \\\"fact\\\": \\\"at_target\\\"}\"",
    "fact_value_array": "String-typed bridge shape. Example: \"[\\\"loc_kitchen\\\"]\""
  },
  "classes": [
    {
      "class": "GdPAIAgent",
      "file": "scripts/nodes/gdpai_agent.gd",
      "extends": "Node",
      "enums": [],
      "signals": [
        { "name": "plan_delivered", "params": [{ "name": "result", "type": "Dictionary" }] }
      ],
      "exports": [
        { "name": "entity", "type": "Node", "default": null },
        { "name": "config", "type": "GdPAIAgentConfig", "default": "GdPAIAgentConfig.new()" }
      ],
      "methods": [
        { "name": "get_current_goal", "params": [], "return": "Goal", "override_point": false },
        { "name": "get_current_plan", "params": [], "return": "Array[Action]", "override_point": false },
        { "name": "get_current_plan_step", "params": [], "return": "int", "override_point": false },
        { "name": "get_current_action", "params": [], "return": "Action", "override_point": false },
        { "name": "is_waiting_for_plan", "params": [], "return": "bool", "override_point": false },
        { "name": "set_planning_strategy", "params": [{ "name": "strategy", "type": "GdPAIAgentConfig.PlanningStrategy" }, { "name": "interval", "type": "float", "default": "0.5" }], "return": "void", "override_point": false },
        { "name": "manually_start_plan", "params": [], "return": "void", "override_point": false },
        { "name": "_on_plan_ready", "params": [{ "name": "result", "type": "Dictionary" }], "return": "void", "override_point": false }
      ],
      "notes": "Plans with goals+actions, executes the action chain. Aliases in dump: get_current_goal/plan/step/action map to get_current_goal/get_current_plan/get_current_plan_step/get_current_action. Needs a GdPAIWorldNode in the scene; planning runs via GdPAIPlanScheduler in the background."
    },
