# OBS WebSocket Configuration
# Copy this to .env and fill in your password, or set in your shell environment
# This file is gitignored - never commit secrets
#
# Setup:
#   1. In OBS: Tools → WebSocket Server Settings → Enable server
#   2. Set password in OBS (matches OBS_PASSWORD below)
#   3. Create a "Godot Capture" scene in OBS with Window Capture source
#   4. Run: cp scripts/.env.example .env && edit .env

OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your_password_here
